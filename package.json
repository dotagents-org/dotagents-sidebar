{
  "name": "dotagents-sidebar",
  "displayName": "dotagents-sidebar",
  "description": "Claude Code and Codex in VS Code's secondary sidebar: several sessions, splits, and agents that keep working across window reloads, with your Claude and ChatGPT accounts as the first tab.",
  "version": "0.0.0",
  "publisher": "gabrieldulolmarques",
  "license": "MIT",
  "author": "Gabriel R. Marques",
  "repository": {
    "type": "git",
    "url": "https://github.com/dotagents-org/dotagents-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/dotagents-org/dotagents-sidebar/issues"
  },
  "homepage": "https://github.com/dotagents-org/dotagents-sidebar#readme",
  "keywords": [
    "claude-code",
    "terminal",
    "sidebar",
    "ai",
    "agent",
    "codex"
  ],
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "scripts": {
    "test": "tsc -p . && tsc -p webview && node --test",
    "package": "npx --yes @vscode/vsce@3 package -o dotagents-sidebar.vsix"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onTerminalProfile:dotagentsSidebar.profile.claude",
    "onTerminalProfile:dotagentsSidebar.profile.codex"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "dotagentsSidebar",
          "title": "dotagents",
          "icon": "media/dotagents-sidebar-line.svg"
        }
      ]
    },
    "views": {
      "dotagentsSidebar": [
        {
          "type": "webview",
          "id": "dotagentsSidebar.view",
          "name": "Sidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "dotagentsSidebar.new",
        "title": "New Claude Code Session",
        "icon": {
          "light": "media/claude-code-light.svg",
          "dark": "media/claude-code-dark.svg"
        },
        "category": "dotagents-sidebar"
      },
      {
        "command": "dotagentsSidebar.new.codex",
        "title": "New Codex Session",
        "icon": {
          "light": "media/codex-light.svg",
          "dark": "media/codex-dark.svg"
        },
        "category": "dotagents-sidebar"
      },
      {
        "command": "dotagentsSidebar.newTerminal",
        "title": "New Terminal",
        "icon": {
          "light": "media/terminal-light.svg",
          "dark": "media/terminal-dark.svg"
        },
        "category": "dotagents-sidebar"
      },
      {
        "command": "dotagentsSidebar.split",
        "title": "Split Session...",
        "icon": {
          "light": "media/split-light.svg",
          "dark": "media/split-dark.svg"
        },
        "category": "dotagents-sidebar"
      },
      {
        "command": "dotagentsSidebar.copy",
        "title": "Copy",
        "category": "dotagents-sidebar"
      },
      {
        "command": "dotagentsSidebar.paste",
        "title": "Paste",
        "category": "dotagents-sidebar"
      },
      {
        "command": "dotagentsSidebar.close",
        "title": "Close Session",
        "icon": {
          "light": "media/close-light.svg",
          "dark": "media/close-dark.svg"
        },
        "category": "dotagents-sidebar"
      },
      {
        "command": "dotagentsSidebar.restart",
        "title": "Restart Session",
        "icon": {
          "light": "media/restart-light.svg",
          "dark": "media/restart-dark.svg"
        },
        "category": "dotagents-sidebar"
      },
      {
        "command": "dotagentsSidebar.rename",
        "title": "Rename Session...",
        "category": "dotagents-sidebar"
      },
      {
        "command": "dotagentsSidebar.recolor",
        "title": "Change Session Color...",
        "category": "dotagents-sidebar"
      },
      {
        "command": "dotagentsSidebar.switchAccount",
        "title": "Switch Account",
        "category": "dotagents-sidebar"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dotagentsSidebar.copy",
          "when": "false"
        },
        {
          "command": "dotagentsSidebar.paste",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "dotagentsSidebar.split",
          "when": "webviewId == 'dotagentsSidebar.view' && webviewSection =~ /^(session|pane)$/",
          "group": "0_split@1"
        },
        {
          "command": "dotagentsSidebar.copy",
          "when": "webviewId == 'dotagentsSidebar.view' && webviewSection == 'pane'",
          "group": "1_clipboard@1"
        },
        {
          "command": "dotagentsSidebar.paste",
          "when": "webviewId == 'dotagentsSidebar.view' && webviewSection == 'pane'",
          "group": "1_clipboard@2"
        },
        {
          "command": "dotagentsSidebar.rename",
          "when": "webviewId == 'dotagentsSidebar.view' && webviewSection =~ /^(session|pane)$/",
          "group": "2_edit@1"
        },
        {
          "command": "dotagentsSidebar.recolor",
          "when": "webviewId == 'dotagentsSidebar.view' && webviewSection =~ /^(session|pane)$/",
          "group": "2_edit@2"
        },
        {
          "command": "dotagentsSidebar.restart",
          "when": "webviewId == 'dotagentsSidebar.view' && webviewSection =~ /^(session|pane)$/",
          "group": "3_run@1"
        },
        {
          "command": "dotagentsSidebar.close",
          "when": "webviewId == 'dotagentsSidebar.view' && webviewSection =~ /^(session|pane)$/",
          "group": "3_run@2"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "dotagentsSidebar.profile.claude",
          "title": "Claude Code",
          "icon": "sparkle"
        },
        {
          "id": "dotagentsSidebar.profile.codex",
          "title": "Codex",
          "icon": "sparkle"
        }
      ]
    },
    "configuration": {
      "title": "dotagents-sidebar",
      "properties": {
        "dotagentsSidebar.renderer": {
          "type": "string",
          "enum": [
            "webgl",
            "dom"
          ],
          "default": "webgl",
          "enumDescriptions": [
            "GPU renderer. Draws block and box characters seamlessly; falls back to DOM when WebGL is unavailable.",
            "DOM renderer. Font-drawn text, but an agent's panels may show hairlines between rows at fractional zoom levels."
          ],
          "description": "How the view draws the terminal. Independent of terminal.integrated.gpuAcceleration."
        },
        "dotagentsSidebar.rightClickBehavior": {
          "type": "string",
          "enum": [
            "terminal",
            "copyPaste",
            "paste",
            "menu"
          ],
          "default": "terminal",
          "enumDescriptions": [
            "As the integrated terminal does (terminal.integrated.rightClickBehavior): copyPaste and paste as below, its other behaviors open the pane's menu.",
            "Copy the selection, or paste when there is none.",
            "Always paste.",
            "Open the pane's menu: Split Session..., Copy, Paste and the session's commands."
          ],
          "markdownDescription": "What a right click on a session's pane does. Shift + right click always opens the pane's menu."
        },
        "dotagentsSidebar.keysForVsCode": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Keys that go to VS Code instead of the agent while a session has focus, on top of the ones worked out like the integrated terminal does (the keys of `#terminal.integrated.commandsToSkipShell#` and the first key of chords). A key starting with `-` goes to the agent instead. Example: `[\"ctrl+e\", \"-ctrl+p\"]`. The keys in use are listed in the dotagents-sidebar output."
        }
      }
    },
    "icons": {
      "dotagents-accounts": {
        "description": "The dotagents accounts mark",
        "default": {
          "fontPath": "media/icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "dotagents-claude": {
        "description": "The Claude mark, on a Claude account",
        "default": {
          "fontPath": "media/icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "dotagents-openai": {
        "description": "The OpenAI mark, on a ChatGPT account",
        "default": {
          "fontPath": "media/icons.woff",
          "fontCharacter": "\\E003"
        }
      }
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.106.0",
    "typescript": "7.0"
  }
}
