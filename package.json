{
  "name": "agents-sidebar",
  "displayName": "dotagents-sidebar",
  "description": "OpenCode, Claude Code and Codex in VS Code's secondary sidebar: several sessions, splits, and agents that keep working across window reloads.",
  "version": "0.7.0",
  "publisher": "gabrieldulolmarques",
  "license": "MIT",
  "author": "Gabriel R. Marques",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrieldulolmarques/dotagents-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/gabrieldulolmarques/dotagents-sidebar/issues"
  },
  "homepage": "https://github.com/gabrieldulolmarques/dotagents-sidebar#readme",
  "keywords": [
    "opencode",
    "claude-code",
    "codex",
    "terminal",
    "sidebar",
    "ai",
    "agent"
  ],
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "scripts": {
    "test": "node --test",
    "package": "npx --yes @vscode/vsce@3 package -o agents-sidebar.vsix"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onTerminalProfile:agentsSidebar.profile.opencode",
    "onTerminalProfile:agentsSidebar.profile.claude",
    "onTerminalProfile:agentsSidebar.profile.codex"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentsSidebar",
          "title": "Agents",
          "icon": "media/dotagents-sidebar-line.svg"
        }
      ]
    },
    "views": {
      "agentsSidebar": [
        {
          "type": "webview",
          "id": "agentsSidebar.view",
          "name": "Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "agentsSidebar.new",
        "title": "Agents: New Session",
        "icon": "$(add)"
      },
      {
        "command": "agentsSidebar.split",
        "title": "Agents: Split Session",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "agentsSidebar.close",
        "title": "Agents: Close Session",
        "icon": {
          "light": "media/trash-light.svg",
          "dark": "media/trash-dark.svg"
        }
      },
      {
        "command": "agentsSidebar.restart",
        "title": "Agents: Restart Session",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentsSidebar.rename",
        "title": "Agents: Rename Session..."
      },
      {
        "command": "agentsSidebar.recolor",
        "title": "Agents: Change Session Color..."
      },
      {
        "command": "agentsSidebar.new.opencode",
        "title": "OpenCode",
        "category": "Agents: New Session"
      },
      {
        "command": "agentsSidebar.new.claude",
        "title": "Claude Code",
        "category": "Agents: New Session"
      },
      {
        "command": "agentsSidebar.new.codex",
        "title": "Codex",
        "category": "Agents: New Session"
      },
      {
        "command": "agentsSidebar.split.opencode",
        "title": "OpenCode",
        "category": "Agents: Split Session"
      },
      {
        "command": "agentsSidebar.split.claude",
        "title": "Claude Code",
        "category": "Agents: Split Session"
      },
      {
        "command": "agentsSidebar.split.codex",
        "title": "Codex",
        "category": "Agents: Split Session"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentsSidebar.new",
          "when": "view == agentsSidebar.view",
          "group": "navigation@1"
        },
        {
          "submenu": "agentsSidebar.newMenu",
          "when": "view == agentsSidebar.view",
          "group": "navigation@2"
        },
        {
          "command": "agentsSidebar.split",
          "when": "view == agentsSidebar.view",
          "group": "navigation@3"
        },
        {
          "command": "agentsSidebar.restart",
          "when": "view == agentsSidebar.view",
          "group": "navigation@4"
        },
        {
          "command": "agentsSidebar.close",
          "when": "view == agentsSidebar.view",
          "group": "navigation@5"
        }
      ],
      "webview/context": [
        {
          "command": "agentsSidebar.rename",
          "when": "webviewId == 'agentsSidebar.view' && webviewSection == 'session'",
          "group": "1_edit@1"
        },
        {
          "command": "agentsSidebar.recolor",
          "when": "webviewId == 'agentsSidebar.view' && webviewSection == 'session'",
          "group": "1_edit@2"
        },
        {
          "command": "agentsSidebar.restart",
          "when": "webviewId == 'agentsSidebar.view' && webviewSection == 'session'",
          "group": "2_run@1"
        },
        {
          "command": "agentsSidebar.close",
          "when": "webviewId == 'agentsSidebar.view' && webviewSection == 'session'",
          "group": "2_run@2"
        }
      ],
      "agentsSidebar.newMenu": [
        {
          "command": "agentsSidebar.new.opencode",
          "group": "1_agents@1"
        },
        {
          "command": "agentsSidebar.new.claude",
          "group": "1_agents@2"
        },
        {
          "command": "agentsSidebar.new.codex",
          "group": "1_agents@3"
        },
        {
          "command": "agentsSidebar.split",
          "group": "2_split@1"
        },
        {
          "submenu": "agentsSidebar.splitMenu",
          "group": "2_split@2"
        }
      ],
      "agentsSidebar.splitMenu": [
        {
          "command": "agentsSidebar.split.opencode",
          "group": "1_agents@1"
        },
        {
          "command": "agentsSidebar.split.claude",
          "group": "1_agents@2"
        },
        {
          "command": "agentsSidebar.split.codex",
          "group": "1_agents@3"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "agentsSidebar.profile.opencode",
          "title": "OpenCode",
          "icon": "code"
        },
        {
          "id": "agentsSidebar.profile.claude",
          "title": "Claude Code",
          "icon": "sparkle"
        },
        {
          "id": "agentsSidebar.profile.codex",
          "title": "Codex",
          "icon": "hubot"
        }
      ]
    },
    "configuration": {
      "title": "dotagents-sidebar",
      "properties": {
        "agentsSidebar.renderer": {
          "type": "string",
          "enum": [
            "webgl",
            "dom"
          ],
          "default": "webgl",
          "enumDescriptions": [
            "GPU renderer. Draws block and box characters seamlessly; falls back to DOM when WebGL is unavailable.",
            "DOM renderer. Font-drawn text, but an agent's panels may show hairlines between rows at fractional zoom levels."
          ],
          "description": "How the view draws the terminal. Independent of terminal.integrated.gpuAcceleration."
        },
        "agentsSidebar.keysForVsCode": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Keys that go to VS Code instead of the agent while a session has focus, on top of the ones worked out like the integrated terminal does (the keys of `#terminal.integrated.commandsToSkipShell#` and the first key of chords). A key starting with `-` goes to the agent instead. Example: `[\"ctrl+e\", \"-ctrl+b\"]`. The keys in use are listed in the dotagents-sidebar output."
        }
      }
    },
    "submenus": [
      {
        "id": "agentsSidebar.newMenu",
        "label": "New Session With...",
        "icon": "$(chevron-down)"
      },
      {
        "id": "agentsSidebar.splitMenu",
        "label": "Split Session With"
      }
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0"
  }
}
