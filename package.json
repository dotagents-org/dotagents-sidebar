{
  "name": "opencode-sidebar",
  "displayName": "OpenCode Sidebar",
  "description": "Runs the OpenCode terminal UI inside a secondary sidebar view, next to Claude Code and Codex.",
  "version": "0.4.0",
  "publisher": "gabrieldulolmarques",
  "license": "MIT",
  "author": "Gabriel R. Marques",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrieldulolmarques/opencode-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/gabrieldulolmarques/opencode-sidebar/issues"
  },
  "homepage": "https://github.com/gabrieldulolmarques/opencode-sidebar#readme",
  "keywords": [
    "opencode",
    "terminal",
    "sidebar",
    "ai",
    "agent"
  ],
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "scripts": {
    "package": "npx --yes @vscode/vsce@3 package -o opencode-sidebar.vsix"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencodeSidebar",
          "title": "OpenCode",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "views": {
      "opencodeSidebar": [
        {
          "type": "webview",
          "id": "opencodeSidebar.view",
          "name": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeSidebar.restart",
        "title": "OpenCode: Restart"
      },
      {
        "command": "opencodeSidebar.openInTerminal",
        "title": "OpenCode: Open in Terminal Panel"
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "opencodeSidebar.profile",
          "title": "OpenCode",
          "icon": "media/opencode.svg"
        }
      ]
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0"
  }
}
