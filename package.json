{
  "name": "opencode-sidebar",
  "displayName": "OpenCode Sidebar",
  "description": "Run the OpenCode terminal UI in VS Code's secondary sidebar.",
  "version": "0.6.0",
  "publisher": "gabrieldulolmarques",
  "license": "MIT",
  "author": "Gabriel R. Marques",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrieldulolmarques/opencode-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/gabrieldulolmarques/opencode-sidebar/issues"
  },
  "homepage": "https://github.com/gabrieldulolmarques/opencode-sidebar#readme",
  "keywords": [
    "opencode",
    "terminal",
    "sidebar",
    "ai",
    "agent"
  ],
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "scripts": {
    "package": "npx --yes @vscode/vsce@3 package -o opencode-sidebar.vsix"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onTerminalProfile:opencodeSidebar.profile"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencodeSidebar",
          "title": "OpenCode",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "views": {
      "opencodeSidebar": [
        {
          "type": "webview",
          "id": "opencodeSidebar.view",
          "name": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeSidebar.restart",
        "title": "OpenCode: Restart",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencodeSidebar.restart",
          "when": "view == opencodeSidebar.view",
          "group": "navigation@1"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "opencodeSidebar.profile",
          "title": "OpenCode",
          "icon": {
            "light": "media/opencode-light.svg",
            "dark": "media/opencode-dark.svg"
          }
        }
      ]
    },
    "configuration": {
      "title": "OpenCode Sidebar",
      "properties": {
        "opencodeSidebar.renderer": {
          "type": "string",
          "enum": [
            "webgl",
            "dom"
          ],
          "default": "webgl",
          "enumDescriptions": [
            "GPU renderer. Draws OpenCode's block characters seamlessly; falls back to DOM when WebGL is unavailable.",
            "DOM renderer. Font-drawn text, but OpenCode's panels may show hairlines between rows at fractional zoom levels."
          ],
          "description": "How the OpenCode view draws the terminal. Independent of terminal.integrated.gpuAcceleration."
        }
      }
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0"
  }
}
