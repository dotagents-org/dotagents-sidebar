{
  "name": "agents-sidebar",
  "displayName": "Agents Sidebar",
  "description": "Run coding agents (OpenCode, Claude Code, Codex) in VS Code's secondary sidebar.",
  "version": "0.7.0",
  "publisher": "gabrieldulolmarques",
  "license": "MIT",
  "author": "Gabriel R. Marques",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrieldulolmarques/agents-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/gabrieldulolmarques/agents-sidebar/issues"
  },
  "homepage": "https://github.com/gabrieldulolmarques/agents-sidebar#readme",
  "keywords": [
    "opencode",
    "claude-code",
    "codex",
    "terminal",
    "sidebar",
    "ai",
    "agent"
  ],
  "categories": [
    "Other"
  ],
  "scripts": {
    "test": "node --test",
    "package": "npx --yes @vscode/vsce@3 package -o agents-sidebar.vsix"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onTerminalProfile:agentsSidebar.profile.opencode"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentsSidebar",
          "title": "Agents",
          "icon": "media/agents.svg"
        }
      ]
    },
    "views": {
      "agentsSidebar": [
        {
          "type": "webview",
          "id": "agentsSidebar.view",
          "name": "Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "agentsSidebar.new",
        "title": "Agents: New Session",
        "icon": "$(add)"
      },
      {
        "command": "agentsSidebar.split",
        "title": "Agents: Split Session",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "agentsSidebar.close",
        "title": "Agents: Close Session",
        "icon": "$(trash)"
      },
      {
        "command": "agentsSidebar.restart",
        "title": "Agents: Restart Session"
      },
      {
        "command": "agentsSidebar.rename",
        "title": "Agents: Rename Session..."
      },
      {
        "command": "agentsSidebar.recolor",
        "title": "Agents: Change Session Color..."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentsSidebar.new",
          "when": "view == agentsSidebar.view",
          "group": "navigation@1"
        },
        {
          "command": "agentsSidebar.split",
          "when": "view == agentsSidebar.view",
          "group": "navigation@2"
        },
        {
          "command": "agentsSidebar.close",
          "when": "view == agentsSidebar.view",
          "group": "navigation@3"
        }
      ],
      "webview/context": [
        {
          "command": "agentsSidebar.rename",
          "when": "webviewId == 'agentsSidebar.view' && webviewSection == 'session'",
          "group": "1_edit@1"
        },
        {
          "command": "agentsSidebar.recolor",
          "when": "webviewId == 'agentsSidebar.view' && webviewSection == 'session'",
          "group": "1_edit@2"
        },
        {
          "command": "agentsSidebar.restart",
          "when": "webviewId == 'agentsSidebar.view' && webviewSection == 'session'",
          "group": "2_run@1"
        },
        {
          "command": "agentsSidebar.close",
          "when": "webviewId == 'agentsSidebar.view' && webviewSection == 'session'",
          "group": "2_run@2"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "agentsSidebar.profile.opencode",
          "title": "OpenCode",
          "icon": {
            "light": "media/opencode-light.svg",
            "dark": "media/opencode-dark.svg"
          }
        }
      ]
    },
    "configuration": {
      "title": "Agents Sidebar",
      "properties": {
        "agentsSidebar.renderer": {
          "type": "string",
          "enum": [
            "webgl",
            "dom"
          ],
          "default": "webgl",
          "enumDescriptions": [
            "GPU renderer. Draws block and box characters seamlessly; falls back to DOM when WebGL is unavailable.",
            "DOM renderer. Font-drawn text, but an agent's panels may show hairlines between rows at fractional zoom levels."
          ],
          "description": "How the view draws the terminal. Independent of terminal.integrated.gpuAcceleration."
        }
      }
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0"
  }
}
